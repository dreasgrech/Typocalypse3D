using UnityEngine;
using System;
using System.Collections;

[Flags]
public enum PlayerStates
{
    NewGameScreen = 1,
    DifficultyScreen = 2,
}

public class PlayerBehaviour : StateMachine<PlayerStates> {
    public int maxBulletsToFire = 20;
    public GameObject muzzleFlash;

    public AudioSource machineGunFire;
    public DyingAnimation dyingAnimation;
    public bool firing;
    public bool dead;

	// Use this for initialization
	private void Start () {
        Messenger.instance.Listen("game", gameObject);
        machineGunFire = transform.GetComponent<AudioSource>();
        dyingAnimation = transform.GetComponent<DyingAnimation>();
	}

    private IEnumerator _EnemyStrike(MessageEnemyStrike message)
    {
        if (!dead)
        {
            dead = true;
            yield return new WaitForSeconds(1);
            dyingAnimation.PlayAnimation();
            new MessagePlayerDied();
        }
    }

    private IEnumerator _EnemyFullMatch(MessageEnemyFullMatch message)
    {
        if (firing)
        {
            yield return null;
        }

        firing = true;
        var enemy = message.Enemy;

		// Look at the enemy before we start shooting
		transform.LookAt(message.Enemy.transform);

		//ChangeAnimationSpeed(0.3);
		animation.CrossFade("Firing");
		machineGunFire.Play();
		muzzleFlash.SetActive(true);

		// Get a random number of bullets to fire
		var bulletsToFire = UnityEngine.Random.Range(2, maxBulletsToFire);
		new MessagePlayerFired(enemy, bulletsToFire);

		enemy.ApplyDamage(bulletsToFire);

		// play the machine gun noise
		yield return new WaitForSeconds(0.2f);
		muzzleFlash.active = false;
		animation.CrossFade("Shooting Idle");
		firing = false;
    }

	void ChangeAnimationSpeed(float newSpeed) {
		foreach(AnimationState state in animation) {
		    state.speed = newSpeed;
		}
	}
	
	// Update is called once per frame
	void Update () {
	
	}
}
